# --- LLM provider -------------------------------------------------------
# auto   = Vultr Serverless Inference if VULTR_INFERENCE_API_KEY + VULTR_MODEL are set, else Gemini
# gemini = always Gemini (free tier from https://aistudio.google.com/apikey)
# vultr  = always Vultr Serverless Inference
LLM_PROVIDER=auto

# Gemini (free tier, no billing needed)
GEMINI_API_KEY=
DS_LLM_MODEL=gemini-3.5-flash-lite

# Vultr Serverless Inference (OpenAI-compatible). Fill these before final deploy/demo.
VULTR_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_MODEL=

SANDBOX_IMAGE=glassbox-sandbox:latest
# runsc enables gVisor (deploy/setup_vultr.sh sets this)
SANDBOX_RUNTIME=
